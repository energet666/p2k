# Рабочие данные: профиль браузера, журналы, служебные файлы
/app/data/

# Загружаемые компоненты
/app/opt/xray/
/app/opt/chromium/

# Ярлыки, которые создаёт setup.sh для конкретного каталога
/p2k-terminal.desktop
/p2k-chrome.desktop

# Личная конфигурация Xray и её резервные копии
/app/xray-config.json
/app/xray-config.json.*

# Архивы комплекта
/dist/
/*.tar.gz
/*.tar.gz.sha256

*.log
.env
.env.*
__pycache__/
